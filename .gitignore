# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
dist-ssr/
build/

# Environment variables & secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Machine Learning & Deep Learning Datasets
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep
dl/data/raw/*
!dl/data/raw/.gitkeep
dl/data/processed/*
!dl/data/processed/.gitkeep

# Trained Models & Binaries
# Ignore temporary training checkpoints and raw weights
*.h5
*.pt
*.pth
*.onnx

# Explicitly track production model artifacts required by the backend
!ml/models/*.joblib
!ml/models/*.json
!dl/models/*.keras
!dl/models/*.pkl
!dl/models/*.json

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE & OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
