# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/scam_detector

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Authentication
JWT_SECRET_KEY=your_secure_random_64_character_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Password Reset Email (SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@scamshield.ai
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GOOGLE_AUTH_BASE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1/users/me
GMAIL_READONLY_SCOPE=https://www.googleapis.com/auth/gmail.readonly

# Deep Learning Model Control (set to true on memory-constrained platforms like Render Free tier)
DISABLE_DL=false

